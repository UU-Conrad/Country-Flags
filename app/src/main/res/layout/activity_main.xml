<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Top Globe Graphic -->
    <ImageView
        android:id="@+id/img_home_globe"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="50dp"
        android:contentDescription="World Globe"
        android:src="@mipmap/ic_launcher" />

    <!-- App Title -->
    <TextView
        android:id="@+id/txt_main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/raleway"
        android:text="Country Flag\nGame"
        android:textAlignment="center"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txt_main_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/raleway"
        android:text="Test your knowledge of\nworld flags and countries!"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <!-- Spacer to push buttons towards bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Filled New Game Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_new_game"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/primary_blue"
        android:fontFamily="@font/raleway"
        android:text="▶  New Country Game"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="28dp" />

    <!-- Outlined About Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_about"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/raleway"
        android:text="ⓘ  About"
        android:textAllCaps="false"
        android:textColor="@color/primary_blue"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:strokeColor="@color/primary_blue"
        app:strokeWidth="1.5dp" />

</LinearLayout>